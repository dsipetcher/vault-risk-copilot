# Environment Configuration Template
# Copy this file to .env and fill in real values
# NEVER commit .env to version control!

# === Node.js API ===
NODE_ENV=development
PORT=3000
API_HOST=0.0.0.0

# === Database ===
DATABASE_URL=postgresql://postgres:password@localhost:5432/vault_risk_copilot
POSTGRES_USER=postgres
POSTGRES_PASSWORD=password
POSTGRES_DB=vault_risk_copilot

# === Risk Service (Python) ===
RISK_SERVICE_URL=http://localhost:8000
RISK_SERVICE_PORT=8000

# === Blockchain ===
# Testnet RPC (use public or your own provider)
SEPOLIA_RPC_URL=https://rpc.sepolia.org
MAINNET_RPC_URL=https://eth.llamarpc.com

# Private key for testnet deployment (throwaway wallet only!)
# NEVER use a wallet with mainnet funds
DEPLOYER_PRIVATE_KEY=

# Deployed contract addresses (fill after deployment)
VAULT_ADDRESS=
MOCK_USDC_ADDRESS=

# Etherscan API key (for verification)
ETHERSCAN_API_KEY=

# === LLM Provider ===
# Choose one provider
LLM_PROVIDER=openai
# Options: openai, anthropic, groq, etc.

# API keys (only add the one you're using)
OPENAI_API_KEY=
ANTHROPIC_API_KEY=

# Model selection
LLM_MODEL=gpt-4o-mini
# Examples: gpt-4o-mini, gpt-4o, claude-3-5-sonnet-20241022

# === External APIs ===
# DeFiLlama (no key required, but check rate limits)
DEFILLAMA_API_URL=https://yields.llama.fi

# Rate limiting
RATE_LIMIT_MAX_REQUESTS=100
RATE_LIMIT_WINDOW_MS=60000

# === MCP Server ===
MCP_SERVER_PORT=3001

# === Collector ===
COLLECTOR_INTERVAL_MINUTES=60

# === Frontend ===
VITE_API_URL=http://localhost:3000
VITE_SEPOLIA_RPC_URL=https://rpc.sepolia.org
VITE_VAULT_ADDRESS=
VITE_MOCK_USDC_ADDRESS=
VITE_CHAIN_ID=11155111

# === Docker Compose ===
COMPOSE_PROJECT_NAME=vault-risk-copilot
