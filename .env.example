# Environment Configuration Template
# Copy this file to .env and fill in real values
# NEVER commit .env to version control!

# === Node.js API ===
NODE_ENV=development
PORT=3000
API_HOST=0.0.0.0

# === Database ===
DATABASE_URL=postgresql://vault_user:vault_pass_local@localhost:5432/vault_risk_copilot
POSTGRES_USER=vault_user
POSTGRES_PASSWORD=vault_pass_local
POSTGRES_DB=vault_risk_copilot
POSTGRES_PORT=5432

# === Risk Service (Python) ===
RISK_SERVICE_URL=http://localhost:8000
RISK_SERVICE_PORT=8000

# === Blockchain ===
# Testnet RPC (use public or your own provider)
RPC_URL=https://rpc.sepolia.org
SEPOLIA_RPC_URL=https://rpc.sepolia.org
MAINNET_RPC_URL=https://eth.llamarpc.com

# Private key for testnet deployment (throwaway wallet only!)
# NEVER use a wallet with mainnet funds
DEPLOYER_PRIVATE_KEY=

# Deployed contract addresses (fill after deployment)
VAULT_ADDRESS=
MOCK_USDC_ADDRESS=

# Etherscan API key (for verification)
ETHERSCAN_API_KEY=

# === LLM Provider ===
# Choose one provider
LLM_PROVIDER=openai
# Options: openai, anthropic, groq, etc.

# API keys (only add the one you're using)
OPENAI_API_KEY=
ANTHROPIC_API_KEY=

# Model selection
LLM_MODEL=gpt-4o-mini
# Examples: gpt-4o-mini, gpt-4o, claude-3-5-sonnet-20241022

# === External APIs ===
# DeFiLlama (no key required, but check rate limits)
DEFILLAMA_API_URL=https://yields.llama.fi

# Rate limiting
RATE_LIMIT_MAX_REQUESTS=100
RATE_LIMIT_WINDOW_MS=60000

# === CORS ===
CORS_ORIGIN=http://localhost:5173

# === Collector ===
COLLECTION_INTERVAL_MS=300000
LOG_LEVEL=info

# === Frontend ===
VITE_API_URL=http://localhost:3000
VITE_CHAIN_ID=11155111
WEB_PORT=5173

# === Service Ports ===
API_PORT=3000
MCP_PORT=3001

# === Docker Compose ===
COMPOSE_PROJECT_NAME=vault-risk-copilot
