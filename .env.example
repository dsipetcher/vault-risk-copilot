# Environment Configuration Template
# Copy this file to .env and fill in real values
# NEVER commit .env to version control!
#
# Quickstart (fresh clone):
#   cp .env.example .env
#   # Generate a 32-byte AES key for SIWE-encrypted LLM key storage:
#   #   openssl rand -base64 32
#   # Paste it into LLM_KEY_ENCRYPTION_KEY below (compose also has a local-only fallback).
#   docker compose up --build

# === Node.js API ===
NODE_ENV=development
PORT=3000
API_HOST=0.0.0.0

# === Database ===
# Compose services always use the in-network hostname `postgres`.
# Do NOT set DATABASE_URL in .env when using docker compose — a localhost URL
# would override the collector default and cause ECONNREFUSED.
# For host-side tools (psql, running the API outside compose):
# DATABASE_URL=postgresql://vault_user:vault_pass_local@localhost:5432/vault_risk_copilot
POSTGRES_USER=vault_user
POSTGRES_PASSWORD=vault_pass_local
POSTGRES_DB=vault_risk_copilot
POSTGRES_PORT=5432

# === Risk Service (Python) ===
# Host-side URL when you run the API on the host. Compose uses http://risk-service:8000.
# RISK_SERVICE_URL=http://localhost:8000
# The risk service is internal to the compose network (no host port by default).
# RISK_SERVICE_PORT=8000
# Shared token for POST /recompute (compose default is fine for local).
RISK_INTERNAL_TOKEN=local-dev-risk-internal-token

# === Blockchain ===
# Testnet RPC (use public or your own provider)
RPC_URL=https://rpc.sepolia.org
SEPOLIA_RPC_URL=https://rpc.sepolia.org
MAINNET_RPC_URL=https://eth.llamarpc.com

# Private key for testnet deployment (throwaway wallet only!)
# NEVER use a wallet with mainnet funds
DEPLOYER_PRIVATE_KEY=

# Deployed contract addresses (fill after deployment)
VAULT_ADDRESS=
MOCK_USDC_ADDRESS=

# Etherscan API key (for verification)
ETHERSCAN_API_KEY=

# === LLM Provider ===
# The API does not use a server-side LLM_API_KEY (BYOK only: UI storage or X-LLM-Api-Key).
# Compose still forwards these for the llm package / local evals; keep the key empty in CI.
LLM_PROVIDER=mock
LLM_API_KEY=
LLM_MODEL=
LLM_BASE_URL=

# === External APIs ===
# DeFiLlama (no key required, but check rate limits)
DEFILLAMA_API_URL=https://yields.llama.fi

# Rate limiting (higher for SPA - 300 requests per 15 minutes by default)
RATE_LIMIT_MAX=300
RATE_LIMIT_WINDOW=15m

# === CORS ===
CORS_ORIGIN=http://localhost:5173

# === Sign-In With Ethereum (SIWE) ===
# Required in production for authentication
# LLM_KEY_ENCRYPTION_KEY: 32-byte base64 key for AES-256-GCM encryption of stored API keys
#   Generate: openssl rand -base64 32
# Compose falls back to a local-only key if this is empty. Generate your own for anything shared.
LLM_KEY_ENCRYPTION_KEY=

# Must match the web origin the browser sends (window.location.host / origin).
SIWE_DOMAIN=localhost:5173
SIWE_URI=http://localhost:5173
# Anvil / Hardhat local + Sepolia. Comma-separated list is also accepted as SIWE_CHAIN_IDS.
SIWE_CHAIN_ID=31337
SIWE_CHAIN_IDS=31337,11155111

# === Collector ===
COLLECTION_INTERVAL_MS=300000
LOG_LEVEL=info

# === Frontend ===
VITE_API_URL=http://localhost:3000
VITE_CHAIN_ID=11155111
WEB_PORT=5173

# === Service Ports ===
API_PORT=3000
MCP_PORT=3001

# === Docker Compose ===
COMPOSE_PROJECT_NAME=vault-risk-copilot
