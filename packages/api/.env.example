# Example environment variables for local development
NODE_ENV=development
PORT=3000
HOST=0.0.0.0

# Database
DATABASE_URL=postgresql://vault_user:vault_pass_local@localhost:5432/vault_risk_copilot

# Risk service
RISK_SERVICE_URL=http://localhost:8000

# Vault (optional, for vault state monitoring)
# RPC_URL=http://localhost:8545
# VAULT_ADDRESS=0xe7f1725E7734CE288F8367e1Bb143E90bb3F0512

# CORS
CORS_ORIGIN=http://localhost:5173,http://localhost:3000

# Rate limiting
RATE_LIMIT_MAX=100
RATE_LIMIT_WINDOW=15m

# Logging
LOG_LEVEL=info

# LLM Key Encryption (SIWE server-side storage)
# Generate with: openssl rand -base64 32
# WARNING: Keep this secret secure! Anyone with this key can decrypt stored LLM API keys.
# LLM_KEY_ENCRYPTION_KEY=

# SIWE Configuration (required in production)
# SIWE_DOMAIN=localhost
# SIWE_URI=http://localhost:3000
# SIWE_CHAIN_ID=1
