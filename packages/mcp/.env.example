# Vault Risk Copilot MCP Server Configuration

# API Base URL (required)
API_BASE_URL=http://localhost:3000

# Optional: LLM API key for explain_pool_risk tool
# If not provided, explain_pool_risk will use fallback mode
# X_LLM_API_KEY=your-api-key-here
# X_LLM_PROVIDER=groq   # required when X_LLM_API_KEY is set
# X_LLM_MODEL=

# HTTP Transport Configuration (optional, only if --transport http is used)
# HTTP_PORT=3001
# HTTP_HOST=localhost
# HTTP_AUTH_TOKEN=your-secret-token-here

# Request Timeout (milliseconds, default: 30000)
# REQUEST_TIMEOUT_MS=30000

# Logging (default: info)
# LOG_LEVEL=info
